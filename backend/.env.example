# Aquapulse — modelo das variáveis de ambiente do back-end.
# Copie este arquivo para backend/.env e preencha com os dados reais do servidor.
# O .env é lido por backend/bootstrap.php (linhas CHAVE=valor; linhas com # são ignoradas)
# e as variáveis são usadas por backend/src/Support/Database.php.
# Sem o arquivo .env (ou sem DB_HOST), o sistema usa os dados simulados de storage/mock/.
# Os comentários ficam em linha própria: um # no fim da linha viraria parte do valor.

# Endereço do servidor MySQL. Só por existir, esta variável faz o Container (backend/src/Support/Container.php) trocar os dados simulados pelos repositórios PDO (banco real).
DB_HOST=127.0.0.1
# Porta do MySQL (o padrão é 3306).
DB_PORT=3306
# Nome do banco (schema) onde foram executados os scripts de backend/storage/mock/sql/.
DB_NAME=aquapulse
# Usuário do banco. Use uma conta com permissão apenas no banco do Aquapulse.
DB_USER=
# Senha do usuário do banco. Preencha somente no .env real, que não é versionado.
DB_PASS=
